# ============================================================
# 观己 · 环境变量示例
# 复制为 .env.local（本地）或在 Vercel → Settings → Environment Variables 填写
# 本文件可提交；切勿把真实密钥写入仓库
# ============================================================

# ── Next.js / NextAuth ──────────────────────────────────────
# 本地开发用 http://localhost:3000；生产填 Vercel 域名，如 https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
# 随机长字符串（建议 32+ 字符）。可用：openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ── 站长单账号（首次登录时自动写入 Supabase，无需手工 SQL）──
# 唯一允许登录的用户名，必须与登录页填写一致
OWNER_USERNAME=owner
# 明文密码（仅服务端环境变量，切勿提交）。与 OWNER_PASSWORD_HASH 二选一，哈希优先
OWNER_PASSWORD=replace-with-a-strong-password
# 可选：bcrypt 哈希（用 `npx bcryptjs-cli hash 'your-password'` 或任意 bcrypt 工具生成）
# OWNER_PASSWORD_HASH=
# 可选：写入 users.email 的邮箱；默认 {OWNER_USERNAME}@guanji.local
# OWNER_EMAIL=you@example.com

# ── Supabase ────────────────────────────────────────────────
# 项目 Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role，仅服务端使用，拥有绕过 RLS 的权限，严禁加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── DeepSeek AI ─────────────────────────────────────────────
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-deepseek-key
# OpenAI 兼容 base URL（不要带 /chat/completions）。文档：https://api-docs.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 兼容旧变量：若仍设置 DEEPSEEK_API_URL，会自动去掉末尾 /chat/completions
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# 官方当前模型：deepseek-flash（默认，V4.1-Flash）或 deepseek-v4-pro
# 旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
DEEPSEEK_MODEL=deepseek-flash
# thinking：disabled（默认，JSON 更稳、更省）或 enabled
DEEPSEEK_THINKING=disabled
# thinking=enabled 时有效：low / high / max（文档默认 high）
# DEEPSEEK_REASONING_EFFORT=high
